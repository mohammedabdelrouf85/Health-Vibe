# =============================================================================
# Health Vibe AI - Environment Variables Reference Guide (.env.example)
# =============================================================================
#
# DUAL ENVIRONMENT SETUP:
# - For local development: copy to .env.development or .env
# - For production hosting: copy to .env.production or set in cloud environment
#
# -----------------------------------------------------------------------------

# Environment Mode: 'development' | 'production'
NODE_ENV=development

# Server Port
# - Development default: 4000
# - Production default: 8080 (or provided by PaaS / Cloud Run / App Engine)
PORT=4000

# Target Firebase Project ID
FIREBASE_PROJECT_ID=health-vibes-a4b3b

# Allowed CORS Origins (comma-separated, without trailing slashes)
# In development: http://localhost:3000,http://127.0.0.1:3000
# In production: https://healthvibe.ai,https://app.healthvibe.ai
CORS_ORIGINS=http://localhost:3000

# Firebase Emulator Integration (Development ONLY)
USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Google Application Credentials (JSON Service Account file path)
# In production, specify absolute path outside repo to a restricted key file
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase App Check Attestation (false in dev, true in production)
ENFORCE_APP_CHECK=false

# Admin access (comma-separated lowercase emails)
OWNER_EMAILS=admin@example.com
REVOKED_VERIFICATION_EMAILS=
