NODE_ENV=development
PORT=4000

# Production should use a service account outside the repository.
# Example on Windows:
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\health-vibe-prod-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Comma-separated production origins, for example:
# CORS_ORIGINS=https://healthvibe.example.com,https://app.healthvibe.example.com
CORS_ORIGINS=http://localhost:3000
