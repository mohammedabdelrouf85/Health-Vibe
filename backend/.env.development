# =============================================================================
# 🛠️ Health Vibe AI - DEVELOPMENT Backend Environment Configuration
# =============================================================================
NODE_ENV=development
PORT=4000
FIREBASE_PROJECT_ID=health-vibes-dev
EXPECTED_FIREBASE_PROJECT_ID=health-vibes-dev

# Local Development Client Whitelist
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500

# Firebase Emulator Support (Development ONLY)
USE_FIREBASE_EMULATOR=true
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Service Account path (optional in dev, required for live Firebase admin access)
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase App Check Attestation (Disabled or Debug token in dev)
ENFORCE_APP_CHECK=false
ALLOW_DEMO_DATA=true
ALLOW_DEVELOPMENT_MODE=true

# Admin access (comma-separated lowercase emails)
OWNER_EMAILS=mohammedabdelrouf85@gmail.com,raouf.work@gmail.com,admin@healthvibe.ai,badr.ahmed.biotech@gmail.com
REVOKED_VERIFICATION_EMAILS=devilunderurwater@gmail.com
