# =============================================================================
# 🚀 Health Vibe AI - PRODUCTION Backend Environment Configuration
# =============================================================================
NODE_ENV=production
PORT=8080
FIREBASE_PROJECT_ID=health-vibes-a4b3b

# Strict Production Domain Whitelist (NO localhost or wildcards allowed in production)
CORS_ORIGINS=https://healthvibe.ai,https://app.healthvibe.ai

# Emulators are STRICTLY FORBIDDEN in production
USE_FIREBASE_EMULATOR=false

# Google Cloud Service Account Key Path (MUST reside outside public webroot)
# Example: C:\secure\health-vibe-prod-service-account.json or /etc/secrets/sa.json
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase App Check Attestation (Enforced in production for zero-trust client verification)
ENFORCE_APP_CHECK=true

# Admin access (comma-separated lowercase emails)
OWNER_EMAILS=mohammedabdelrouf85@gmail.com,raouf.work@gmail.com,admin@healthvibe.ai,badr.ahmed.biotech@gmail.com
REVOKED_VERIFICATION_EMAILS=devilunderurwater@gmail.com
