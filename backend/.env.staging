# =============================================================================
# Health Vibe AI - STAGING Backend Environment Configuration
# =============================================================================
NODE_ENV=staging
PORT=8080
FIREBASE_PROJECT_ID=health-vibes-staging
EXPECTED_FIREBASE_PROJECT_ID=health-vibes-staging

# Staging Domain Whitelist
CORS_ORIGINS=https://staging.healthvibe.ai

# Staging uses its own Firebase project, never local emulators.
USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# Service Account path for the staging Firebase project.
GOOGLE_APPLICATION_CREDENTIALS=

# App Check can be enforced once the staging client key is registered.
ENFORCE_APP_CHECK=false
ALLOW_DEMO_DATA=false
ALLOW_DEVELOPMENT_MODE=false

# Admin access (comma-separated lowercase emails)
OWNER_EMAILS=mohammedabdelrouf85@gmail.com,raouf.work@gmail.com,admin@healthvibe.ai,badr.ahmed.biotech@gmail.com
REVOKED_VERIFICATION_EMAILS=devilunderurwater@gmail.com
