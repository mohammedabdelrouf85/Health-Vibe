# =============================================================================
# Health Vibe AI - Environment Variables Reference Guide (.env.example)
# Smart Respiratory Clinical Assessment & Multi-Specialty AI Platform
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' or '.env.development' for local development.
# 2. Never commit actual secret keys, API tokens, or credentials to version control.
# 3. For production deployment, set these variables in your hosting provider
#    or secret manager (Google Cloud Secret Manager / Firebase Environment).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# -----------------------------------------------------------------------------
# Runtime environment: 'development' | 'staging' | 'production'
NODE_ENV=development

# Server HTTP listening port
PORT=4000

# Server host binding (use 0.0.0.0 for Docker / containerized environments)
HOST=0.0.0.0

# Base public application URL
APP_URL=http://localhost:3000

# API base prefix
API_PREFIX=/api

# Allowed CORS Origins (comma-separated, without trailing slashes)
# In development: http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000
# In production: https://healthvibes.app,https://health-vibes-a4b3b.web.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000

# -----------------------------------------------------------------------------
# 2. FIREBASE & CLOUD INFRASTRUCTURE
# -----------------------------------------------------------------------------
# Target Firebase project identifier
FIREBASE_PROJECT_ID=health-vibes-a4b3b
EXPECTED_FIREBASE_PROJECT_ID=health-vibes-a4b3b

# Firebase Storage Bucket URL
FIREBASE_STORAGE_BUCKET=health-vibes-a4b3b.firebasestorage.app

# Firebase Emulator Suite Integration (Set to 'true' for local offline testing)
USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
FIREBASE_FUNCTIONS_EMULATOR_HOST=localhost:5001

# Google Service Account Credentials
# Path to service account JSON file, or set individual fields in cloud run
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@health-vibes-a4b3b.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Firebase App Check Attestation (Set to 'true' in staging and production)
ENFORCE_APP_CHECK=false
APP_CHECK_DEBUG_TOKEN=

# -----------------------------------------------------------------------------
# 3. SECURITY, ENCRYPTION & DATA PROTECTION
# -----------------------------------------------------------------------------
# Secret key for AES-256-GCM symmetric encryption of sensitive clinical records at rest
# MUST be exactly 64 hexadecimal characters (32 bytes)
AES_256_GCM_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session signing secret
SESSION_SECRET=super_secret_session_signing_key_change_in_production_min_32_chars!

# JWT token secret for inter-service communication and verification tokens
JWT_SECRET=super_secure_jwt_token_secret_health_vibe_ai_2026_production

# JWT Expiration duration (e.g., '1h', '24h', '7d')
JWT_EXPIRATION=24h

# Pepper string for password hashing (Bcrypt + SHA256 pepper)
PASSWORD_HASH_PEPPER=clinical_grade_password_pepper_health_vibe_production

# -----------------------------------------------------------------------------
# 4. ACCESS CONTROL, ADMIN & CLINICAL ROLES
# -----------------------------------------------------------------------------
# Initial System Owner / Super-Admin Email addresses (comma-separated, lowercase)
OWNER_EMAILS=admin@healthvibes.app,mohamed@healthvibes.app

# Revoked doctor verification emails (blacklist for immediate deactivation)
REVOKED_VERIFICATION_EMAILS=

# Development feature flags
ALLOW_DEMO_DATA=true
ALLOW_DEVELOPMENT_MODE=true

# -----------------------------------------------------------------------------
# 5. MACHINE LEARNING & CLINICAL AI ENGINE
# -----------------------------------------------------------------------------
# Default Random Forest model version for respiratory clinical triage
DEFAULT_MODEL_VERSION=resp_rf_v1.0.2

# Path to machine learning model artifacts directory
MODEL_ARTIFACTS_DIR=ml_models/artifacts

# Model drift detection and clinical confidence threshold
ML_DRIFT_DETECTION_ENABLED=true
ML_CONFIDENCE_THRESHOLD=0.85
ML_FALSE_NEGATIVE_SAFETY_GUARD=true

# -----------------------------------------------------------------------------
# 6. EXTERNAL COMMUNICATIONS & GATEWAYS
# -----------------------------------------------------------------------------
# WhatsApp Business Cloud API / Twilio Messaging
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=health_vibe_webhook_token_verify_2026

# Email Dispatch Gateway (SendGrid / Postmark / SMTP)
EMAIL_SERVICE_PROVIDER=sendgrid
SENDGRID_API_KEY=
SYSTEM_NOTIFICATION_EMAIL=noreply@healthvibes.app
CLINICAL_SUPPORT_EMAIL=support@healthvibes.app

# Telehealth Video Provider (Twilio Video / Jitsi / WebRTC Gateway)
TELEHEALTH_VIDEO_PROVIDER=internal-webrtc
TELEHEALTH_API_KEY=
TELEHEALTH_API_SECRET=

# Medical OCR Provider (Google Cloud Vision / Tesseract)
MEDICAL_OCR_PROVIDER=google-cloud-vision
GOOGLE_VISION_API_KEY=

# Google Calendar Integration for Doctor Consultations
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/api/calendar/callback

# -----------------------------------------------------------------------------
# 7. OBSERVABILITY, MONITORING & AUDIT
# -----------------------------------------------------------------------------
# Sentry DSN for error monitoring & performance profiling
SENTRY_DSN=

# Logging level: 'error' | 'warn' | 'info' | 'http' | 'verbose' | 'debug' | 'silly'
LOG_LEVEL=info

# Opsgenie / Slack Alerting Webhook URL for adverse security & clinical incidents
INCIDENT_ALERT_WEBHOOK_URL=

# Audit log retention period in days (HIPAA & Egyptian Health Law requires 1825 days / 5 years)
AUDIT_LOG_RETENTION_DAYS=1825
