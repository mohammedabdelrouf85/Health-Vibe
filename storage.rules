rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDoc(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid));
    }

    function appDoc(appId) {
      return firestore.get(/databases/(default)/documents/doctor_applications/$(appId));
    }

    function appExists(appId) {
      return firestore.exists(/databases/(default)/documents/doctor_applications/$(appId));
    }

    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.role in ['clinic_admin', 'super_admin'];
    }

    function isSuspended() {
      return isAuthenticated() && (
        ('suspended' in request.auth.token && request.auth.token.suspended == true) ||
        ('isSuspended' in request.auth.token && request.auth.token.isSuspended == true) ||
        ('status' in request.auth.token && request.auth.token.status == 'suspended') ||
        ('disabled' in request.auth.token && request.auth.token.disabled == true) ||
        userDoc(request.auth.uid).data.suspended == true ||
        userDoc(request.auth.uid).data.isSuspended == true ||
        userDoc(request.auth.uid).data.status == 'suspended' ||
        userDoc(request.auth.uid).data.accountStatus == 'suspended' ||
        userDoc(request.auth.uid).data.disabled == true
      );
    }

    function authClinicId() {
      return isAuthenticated() && 'clinicId' in request.auth.token ? request.auth.token.clinicId :
             'clinicId' in userDoc(request.auth.uid).data ? userDoc(request.auth.uid).data.clinicId :
             'clinic' in userDoc(request.auth.uid).data ? userDoc(request.auth.uid).data.clinic :
             null;
    }

    function isPlatformAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super_admin';
    }

    function isClinicAdminForApplication(appId) {
      return isAuthenticated() &&
             request.auth.token.role == 'clinic_admin' &&
             authClinicId() != null &&
             appExists(appId) &&
             (
               appDoc(appId).data.clinicId == authClinicId() ||
               appDoc(appId).data.clinic == authClinicId()
             );
    }

    function ownerCanWriteDoctorApplicationFile(userId, appId) {
      return isOwner(userId) &&
             !isSuspended() &&
             appId == 'app_' + userId &&
             (
               !appExists(appId) ||
               (
                 appDoc(appId).data.userId == userId &&
                 appDoc(appId).data.status in ['pending', 'cancelled']
               )
             );
    }

    function adminCanReadDoctorApplicationFile(userId, appId) {
      return isAdmin() &&
             !isSuspended() &&
             appExists(appId) &&
             appDoc(appId).data.userId == userId &&
             appDoc(appId).data.status in ['pending', 'approved', 'rejected'] &&
             (isPlatformAdmin() || isClinicAdminForApplication(appId));
    }

    function hasAllowedDoctorApplicationExtension(fileName) {
      return fileName.matches('.*\\.([pP][dD][fF]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[pP][nN][gG]|[wW][eE][bB][pP])$');
    }

    function hasBlockedExecutableExtension(fileName) {
      return fileName.matches('.*\\.([eE][xX][eE]|[dD][lL][lL]|[bB][aA][tT]|[cC][mM][dD]|[cC][oO][mM]|[mM][sS][iI]|[pP][sS]1|[sS][hH]|[jJ][sS]|[vV][bB][sS]|[sS][cC][rR]|[jJ][aA][rR]|[aA][pP][kK]|[dD][mM][gG])$');
    }

    function isAllowedDoctorApplicationFile(fileName) {
      return request.resource != null &&
             request.resource.size <= 10 * 1024 * 1024 &&
             request.resource.contentType in [
               'application/pdf',
               'image/jpeg',
               'image/png',
               'image/webp'
             ] &&
             hasAllowedDoctorApplicationExtension(fileName) &&
             !hasBlockedExecutableExtension(fileName);
    }

    match /doctor_applications/{userId}/{appId}/{fileName} {
      allow read: if isOwner(userId) || adminCanReadDoctorApplicationFile(userId, appId);
      allow create, update: if ownerCanWriteDoctorApplicationFile(userId, appId) &&
                            isAllowedDoctorApplicationFile(fileName);
      allow delete: if ownerCanWriteDoctorApplicationFile(userId, appId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
