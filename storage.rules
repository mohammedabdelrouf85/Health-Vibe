rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDoc(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid));
    }

    function appDoc(appId) {
      return firestore.get(/databases/(default)/documents/doctor_applications/$(appId));
    }

    function appExists(appId) {
      return firestore.exists(/databases/(default)/documents/doctor_applications/$(appId));
    }

    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.role in ['clinic_admin', 'super_admin'];
    }

    function ownerCanWriteDoctorApplicationFile(userId, appId) {
      return isOwner(userId) &&
             appId == 'app_' + userId &&
             (
               !appExists(appId) ||
               (
                 appDoc(appId).data.userId == userId &&
                 appDoc(appId).data.status in ['pending', 'cancelled']
               )
             );
    }

    function adminCanReadDoctorApplicationFile(userId, appId) {
      return isAdmin() &&
             appExists(appId) &&
             appDoc(appId).data.userId == userId &&
             appDoc(appId).data.status in ['pending', 'approved', 'rejected'];
    }

    function hasAllowedDoctorApplicationExtension(fileName) {
      return fileName.matches('.*\\.([pP][dD][fF]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[pP][nN][gG]|[wW][eE][bB][pP])$');
    }

    function hasBlockedExecutableExtension(fileName) {
      return fileName.matches('.*\\.([eE][xX][eE]|[dD][lL][lL]|[bB][aA][tT]|[cC][mM][dD]|[cC][oO][mM]|[mM][sS][iI]|[pP][sS]1|[sS][hH]|[jJ][sS]|[vV][bB][sS]|[sS][cC][rR]|[jJ][aA][rR]|[aA][pP][kK]|[dD][mM][gG])$');
    }

    function isAllowedDoctorApplicationFile(fileName) {
      return request.resource != null &&
             request.resource.size <= 10 * 1024 * 1024 &&
             request.resource.contentType in [
               'application/pdf',
               'image/jpeg',
               'image/png',
               'image/webp'
             ] &&
             hasAllowedDoctorApplicationExtension(fileName) &&
             !hasBlockedExecutableExtension(fileName);
    }

    match /doctor_applications/{userId}/{appId}/{fileName} {
      allow read: if isOwner(userId) || adminCanReadDoctorApplicationFile(userId, appId);
      allow create, update: if ownerCanWriteDoctorApplicationFile(userId, appId) &&
                            isAllowedDoctorApplicationFile(fileName);
      allow delete: if ownerCanWriteDoctorApplicationFile(userId, appId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
