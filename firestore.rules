rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions for Authentication & RBAC ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner() {
      return isAuthenticated() && 
             'email' in request.auth.token &&
             request.auth.token.email.lower() == 'mohammedabdelrouf85@gmail.com';
    }
    
    function hasUserDoc() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return hasUserDoc() && ('role' in getUserData()) ? getUserData().role : 'patient';
    }
    
    function isAdmin() {
      return isOwner() || (isAuthenticated() && getUserRole() == 'admin');
    }
    
    // Doctor role is strictly clinical and separated from Admin
    function isDoctor() {
      return isAuthenticated() && getUserRole() == 'doctor';
    }
    
    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- 1. Users Collection ---
    // - Self can read their own profile; Doctors and Admins can read user profiles
    // - Self can create their own doc with role == 'patient' (Owner gets 'admin')
    // - Privilege escalation prevention: self cannot change their own role or isOwner status
    // - Admin / Owner can update roles and manage users
    match /users/{userId} {
      allow read: if isAuthenticated() && (isSelf(userId) || isDoctor() || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                    (isOwner() ? request.resource.data.role == 'admin' : request.resource.data.role == 'patient');
      allow update: if isOwner() || isAdmin() || 
                    (isSelf(userId) && 
                     request.resource.data.role == resource.data.role &&
                     (!('isOwner' in request.resource.data) || request.resource.data.isOwner == resource.data.isOwner));
      allow delete: if isAdmin();
    }

    // --- 2. Doctor Applications Collection (Application -> Verification -> Approval) ---
    // - Applicant can read their own application, Admins can read all applications
    // - Applicant can submit (create) their own application with status == 'pending'
    // - Applicant can cancel their pending application; Only Admin can approve, reject, or delete
    match /doctor_applications/{appId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (isSelf(resource.data.userId) && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    // --- 3. Clinical Cases Collection ---
    // - Privacy protection: Patient can ONLY read their own cases; Doctors and Admins can read assigned cases
    // - Authenticated patient creates case for themselves with status == 'pending'
    // - ONLY licensed Doctors can clinically review/approve/reject cases (update)
    // - Admins can manage or clean up records (delete) but cannot alter clinical medical diagnoses
    match /cases/{caseId} {
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isDoctor() || isAdmin());
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending';
      allow update: if isDoctor();
      allow delete: if isAdmin();
    }

    // --- 4. Audit Log Events ---
    // - Strictly Admin can read audit logs
    // - Authenticated actions can append log events
    // - Immutable audit trail: updates and deletions are strictly forbidden
    match /audit_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
