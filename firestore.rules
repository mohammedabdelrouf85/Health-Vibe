rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Core Identity, Role Resolution, and Security Helper Functions
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwner() {
      return isAuthenticated() && (
        ('isOwner' in request.auth.token && request.auth.token.isOwner == true) ||
        ('email' in request.auth.token && request.auth.token.email.lower() == 'mohammedabdelrouf85@gmail.com')
      );
    }

    function isEmailVerified() {
      return isAuthenticated() && (
        request.auth.token.email_verified == true || isOwner()
      );
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isSuspended() {
      return isAuthenticated() && (
        ('suspended' in request.auth.token && request.auth.token.suspended == true) ||
        ('status' in request.auth.token && request.auth.token.status == 'suspended') ||
        (hasUserDoc(request.auth.uid) && (
          ('suspended' in getUserDoc(request.auth.uid) && getUserDoc(request.auth.uid).suspended == true) ||
          ('status' in getUserDoc(request.auth.uid) && getUserDoc(request.auth.uid).status == 'suspended')
        ))
      );
    }

    function isActive() {
      return isAuthenticated() && !isSuspended();
    }

    // Role resolution: Custom Claim token > Firestore users doc > default 'patient'
    function getRole() {
      return 'role' in request.auth.token ? request.auth.token.role :
             (hasUserDoc(request.auth.uid) && 'role' in getUserDoc(request.auth.uid)) ? getUserDoc(request.auth.uid).role :
             'patient';
    }

    // Clinic resolution: Custom Claim token > Firestore users doc > null
    function getClinicId() {
      return 'clinicId' in request.auth.token ? request.auth.token.clinicId :
             (hasUserDoc(request.auth.uid) && 'clinicId' in getUserDoc(request.auth.uid)) ? getUserDoc(request.auth.uid).clinicId :
             null;
    }

    function isSuperAdmin() {
      return isActive() && (isOwner() || getRole() == 'super_admin');
    }

    function isClinicAdmin() {
      return isActive() && getRole() == 'clinic_admin';
    }

    function isClinicAdminFor(clinicId) {
      return isSuperAdmin() || (isClinicAdmin() && getClinicId() != null && getClinicId() == clinicId);
    }

    function isVerifiedDoctor() {
      return isActive() && getRole() == 'doctor' && (
        ('verifiedDoctor' in request.auth.token && request.auth.token.verifiedDoctor == true) ||
        (hasUserDoc(request.auth.uid) && 'verifiedDoctor' in getUserDoc(request.auth.uid) && getUserDoc(request.auth.uid).verifiedDoctor == true)
      );
    }

    function isAssignedDoctor(caseData) {
      return isVerifiedDoctor() && (
        ('assignedDoctorId' in caseData && caseData.assignedDoctorId == request.auth.uid) ||
        ('doctorId' in caseData && caseData.doctorId == request.auth.uid)
      );
    }

    function isPatient() {
      return isActive() && getRole() == 'patient';
    }

    // =========================================================================
    // 1. Users Collection
    // =========================================================================
    // - Self can read own profile (if active)
    // - Super Admin can read all users
    // - Clinic Admin can read users of their assigned clinic only
    // - Zero leakage to unrelated patients or other clinics
    // - Client privilege escalation strictly forbidden: role, isOwner, suspended cannot be edited
    match /users/{userId} {
      allow read: if isActive() && (
        isSelf(userId) ||
        isSuperAdmin() ||
        (isClinicAdmin() && 'clinicId' in resource.data && resource.data.clinicId == getClinicId())
      );
      allow create: if isAuthenticated() && !isSuspended() && request.auth.uid == userId &&
                    !request.resource.data.keys().hasAny(['role', 'isOwner', 'verifiedDoctor', 'suspended']);
      allow update: if isActive() &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isOwner', 'verifiedDoctor', 'suspended', 'doctorApplicationStatus']) &&
                    (isSelf(userId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 2. Doctor Applications Collection
    // =========================================================================
    // - Applicant can read their own application
    // - Clinic Admin can read applications for their clinic
    // - Super Admin can read all applications
    match /doctor_applications/{appId} {
      allow read: if isActive() && (
        (resource.data.userId == request.auth.uid) ||
        isClinicAdminFor(resource.data.clinicId) ||
        isSuperAdmin()
      );
      allow create: if isEmailVerified() && !isSuspended() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending' &&
                    (getClinicId() == null || !('clinicId' in request.resource.data) || request.resource.data.clinicId == getClinicId());
      allow update: if isActive() && isEmailVerified() && (
        (isSelf(resource.data.userId) && resource.data.status == 'pending' && request.resource.data.status == 'cancelled') ||
        (isClinicAdminFor(resource.data.clinicId) && resource.data.status == 'pending' && request.resource.data.status in ['approved', 'rejected'])
      );
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 3. Clinical Cases Collection
    // =========================================================================
    // - Patients can only read their own released cases (unreleased/under_review hidden)
    // - Doctors can ONLY read verified cases assigned to them in their clinic
    // - Support role has ZERO clinical access
    // - Clinic Admins can only read cases in their own clinic
    // - Direct client updates are disallowed (authoritative transitions go through backend API)
    match /cases/{caseId} {
      allow read: if isActive() && (
        (
          resource.data.patientId == request.auth.uid &&
          resource.data.status != 'under_review' &&
          (!('clinicalImpression' in resource.data) || resource.data.doctorApproved == true)
        ) ||
        (
          isAssignedDoctor(resource.data) &&
          (getClinicId() == null || !('clinicId' in resource.data) || resource.data.clinicId == getClinicId())
        ) ||
        (
          'clinicId' in resource.data && isClinicAdminFor(resource.data.clinicId)
        ) ||
        isSuperAdmin()
      );

      allow create: if isEmailVerified() && !isSuspended() &&
                    request.resource.data.patientId == request.auth.uid &&
                    request.resource.data.status in ['submitted', 'pending'] &&
                    !request.resource.data.keys().hasAny(['doctorApproved', 'clinicalImpression', 'clinicalDiagnosis', 'doctorNotes']) &&
                    (getClinicId() == null || !('clinicId' in request.resource.data) || request.resource.data.clinicId == getClinicId());

      allow update: if false; // All clinical approvals, updates, and triage go through server API
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 4. Reports, Medical Reports, Clinical Reports
    // =========================================================================
    // - Patients can only read released (approved) reports for themselves
    // - Draft reports are blocked from patients
    // - Support has ZERO clinical access
    // - Clinic Admins can read reports within their clinic only
    // - Client writes are blocked (generated server-side)
    match /{reportCollection}/{reportId} {
      allow read: if reportCollection in ['reports', 'medical_reports', 'clinical_reports'] &&
                  isActive() && (
                    (
                      resource.data.patientId == request.auth.uid &&
                      resource.data.doctorApproved == true &&
                      resource.data.status == 'approved'
                    ) ||
                    (
                      'clinicId' in resource.data && isClinicAdminFor(resource.data.clinicId)
                    ) ||
                    (
                      isVerifiedDoctor() && isAssignedDoctor(resource.data) &&
                      (getClinicId() == null || !('clinicId' in resource.data) || resource.data.clinicId == getClinicId())
                    ) ||
                    isSuperAdmin()
                  );
      allow write: if false;
    }

    // =========================================================================
    // 5. Appointments Collection
    // =========================================================================
    match /appointments/{apptId} {
      allow read: if isActive() && (
        (isPatient() && resource.data.patientId == request.auth.uid) ||
        (isVerifiedDoctor() && resource.data.doctorId == request.auth.uid) ||
        isClinicAdminFor(resource.data.clinicId)
      );
      allow create: if isActive() && (
        (isPatient() && request.resource.data.patientId == request.auth.uid &&
         (getClinicId() == null || !('clinicId' in request.resource.data) || request.resource.data.clinicId == getClinicId())) ||
        isClinicAdminFor(request.resource.data.clinicId)
      );
      allow update: if isActive() && (
        (isPatient() && resource.data.patientId == request.auth.uid && request.resource.data.patientId == request.auth.uid) ||
        (isVerifiedDoctor() && resource.data.doctorId == request.auth.uid) ||
        isClinicAdminFor(resource.data.clinicId)
      );
      allow delete: if isClinicAdminFor(resource.data.clinicId);
    }

    // =========================================================================
    // 6. AI Model Metrics Collection
    // =========================================================================
    match /ai_model_metrics/{metricId} {
      allow read: if isActive() && (
        ('clinicId' in resource.data && isClinicAdminFor(resource.data.clinicId)) ||
        isSuperAdmin()
      );
      allow write: if false;
    }

    // =========================================================================
    // 7. Feedbacks Collection
    // =========================================================================
    match /feedbacks/{feedbackId} {
      allow read: if isActive() && (
        isSuperAdmin() ||
        ('clinicId' in resource.data && isClinicAdminFor(resource.data.clinicId)) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isActive() &&
                    request.resource.data.userId == request.auth.uid &&
                    (getClinicId() == null || !('clinicId' in request.resource.data) || request.resource.data.clinicId == getClinicId());
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 8. System Settings Collection
    // =========================================================================
    match /system_settings/{settingId} {
      allow read: if isActive();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 9. Audit Events and Audit Log
    // =========================================================================
    // - Immutable security audit trail: append-only, readable only by Super Admin
    match /audit_events/{eventId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /auditLog/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
