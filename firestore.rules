rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 🔐 HELPER FUNCTIONS (Zero-Trust Authentication & Strict RBAC)
    // =========================================================================

    function isUserAuthenticated() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isUserAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 🛑 BLOCK SUSPENDED ACCOUNTS
    // Blocks all operations for accounts flagged as suspended in Auth claims or user documents
    function isSuspended() {
      return isUserAuthenticated() && (
        ('suspended' in request.auth.token && request.auth.token.suspended == true) ||
        ('status' in request.auth.token && request.auth.token.status == 'suspended') ||
        ('disabled' in request.auth.token && request.auth.token.disabled == true) ||
        ('isSuspended' in request.auth.token && request.auth.token.isSuspended == true) ||
        (hasUserDoc() && (
          ('suspended' in getUserData() && getUserData().suspended == true) ||
          ('status' in getUserData() && getUserData().status == 'suspended') ||
          ('accountStatus' in getUserData() && getUserData().accountStatus == 'suspended') ||
          ('disabled' in getUserData() && getUserData().disabled == true) ||
          ('isSuspended' in getUserData() && getUserData().isSuspended == true)
        ))
      );
    }

    function isAuthenticated() {
      return isUserAuthenticated() && !isSuspended();
    }

    function isVerificationRevoked() {
      return isAuthenticated() &&
             'email' in request.auth.token &&
             request.auth.token.email.lower() in [
               'devilunderurwater@gmail.com'
             ];
    }

    // 👑 MASTER OWNER PRIVILEGE
    // Unrestricted super-admin & owner check across authentication claims, emails, and user docs
    function isOwner() {
      return isAuthenticated() &&
             !isVerificationRevoked() &&
             (('isOwner' in request.auth.token && request.auth.token.isOwner == true) ||
              ('role' in request.auth.token && (request.auth.token.role == 'owner' || request.auth.token.role == 'super_admin')) ||
              ('email' in request.auth.token && (
                request.auth.token.email.lower() == 'mohammedabdelrouf85@gmail.com' ||
                request.auth.token.email.lower() == 'raouf.work@gmail.com' ||
                request.auth.token.email.lower() == 'admin@healthvibe.ai' ||
                request.auth.token.email.lower() == 'badr.ahmed.biotech@gmail.com'
              )) ||
              (hasUserDoc() && (
                ('isOwner' in getUserData() && getUserData().isOwner == true) ||
                ('role' in getUserData() && (getUserData().role == 'owner' || getUserData().role == 'super_admin'))
              )));
    }

    // Strict Email Verification check
    function isEmailVerified() {
      return isAuthenticated() && !isVerificationRevoked() && (
        request.auth.token.email_verified == true || 
        isOwner() ||
        (hasUserDoc() && (
          ('emailVerified' in getUserData() && getUserData().emailVerified == true) ||
          ('phoneVerified' in getUserData() && getUserData().phoneVerified == true)
        ))
      );
    }

    // Role extraction: Custom Claims (tamper-proof JWT) take precedence over Firestore doc
    function getUserRole() {
      return !isAuthenticated() ? 'unauthenticated' :
             isOwner() ? 'super_admin' :
             ('role' in request.auth.token) ? request.auth.token.role :
             (hasUserDoc() && ('role' in getUserData())) ? getUserData().role : 'patient';
    }

    function isAdmin() {
      return isOwner() || (isAuthenticated() && (getUserRole() == 'clinic_admin' || getUserRole() == 'super_admin'));
    }

    function isSupport() {
      return isAuthenticated() && getUserRole() == 'support';
    }

    // Doctor role is strictly clinical and separated from administrative access
    function isDoctor() {
      return isAuthenticated() && (
        isOwner() ||
        getUserRole() == 'doctor' ||
        (hasUserDoc() && (
          ('role' in getUserData() && getUserData().role == 'doctor') ||
          ('verifiedDoctor' in getUserData() && getUserData().verifiedDoctor == true)
        ))
      );
    }

    // Doctor can access cases assigned to their UID or Owner has universal access
    function isAssignedDoctor() {
      return isOwner() || (isDoctor() && (
        ('assignedDoctorId' in resource.data && resource.data.assignedDoctorId == request.auth.uid) ||
        ('doctorId' in resource.data && resource.data.doctorId == request.auth.uid) ||
        ('doctorUid' in resource.data && resource.data.doctorUid == request.auth.uid) ||
        ('approvingDoctorId' in resource.data && resource.data.approvingDoctorId == request.auth.uid)
      ));
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // 1. 👥 USERS COLLECTION (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner() || (isAuthenticated() && (isSelf(userId) || isAdmin()));

      allow create: if isOwner() || (isAuthenticated() &&
                    isSelf(userId) &&
                    !request.resource.data.keys().hasAny([
                      'role', 'isOwner', 'doctorVerified', 'verifiedDoctor', 'doctorApplicationStatus'
                    ]));

      allow update: if isOwner() || (isAuthenticated() && (
        (isSelf(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isOwner', 'doctorVerified', 'verifiedDoctor', 'doctorApplicationStatus',
          'suspended', 'isSuspended', 'status', 'accountStatus', 'disabled'
        ])) ||
        (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isOwner'
        ]))
      ));

      allow delete: if isOwner() || isAdmin();
    }

    // =========================================================================
    // 2. 🩺 DOCTOR APPLICATIONS (/doctor_applications/{appId})
    // =========================================================================
    function hasValidDoctorApplicationDocument(data) {
      return data.keys().hasAll(['docName', 'docSize', 'docContentType', 'storagePath', 'downloadURL']) &&
             data.docName is string &&
             data.docSize is number &&
             data.docSize > 0 &&
             data.docSize <= 10 * 1024 * 1024 &&
             data.docContentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'] &&
             data.storagePath is string &&
             data.storagePath.matches('^doctor_applications/' + request.auth.uid + '/app_' + request.auth.uid + '/.+') &&
             data.downloadURL is string;
    }

    match /doctor_applications/{appId} {
      allow read: if isOwner() || (isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid));

      allow create: if isOwner() || (isEmailVerified() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending' &&
                    hasValidDoctorApplicationDocument(request.resource.data));

      allow update: if isOwner() || ((isAdmin() && isEmailVerified() &&
                       resource.data.status == 'pending' &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.status in ['approved', 'rejected']) ||
                      (isSelf(resource.data.userId) &&
                       resource.data.status == 'pending' &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.status == 'cancelled'));

      allow delete: if isOwner() || isAdmin();
    }

    // =========================================================================
    // 🩺 CLINICAL ASSESSMENT VALIDATION HELPERS
    // =========================================================================
    
    function isValidOxygen(data) {
      return (!('oxygenLevel' in data) || (data.oxygenLevel is number && data.oxygenLevel >= 50 && data.oxygenLevel <= 100)) &&
             (!('o2' in data) || (data.o2 is number && data.o2 >= 50 && data.o2 <= 100));
    }

    function isValidBreathing(data) {
      return !('breathingDifficulty' in data) || 
             (data.breathingDifficulty is string && data.breathingDifficulty.size() > 0 && data.breathingDifficulty.size() <= 40);
    }

    function isValidCough(data) {
      return !('coughLevel' in data) || 
             (data.coughLevel is string && data.coughLevel.size() > 0 && data.coughLevel.size() <= 40);
    }

    function isValidDuration(data) {
      return !('symptomDuration' in data) || 
             (data.symptomDuration is string && data.symptomDuration.size() > 0 && data.symptomDuration.size() <= 50);
    }

    function isValidRiskFactors(data) {
      return !('riskFactors' in data) || 
             (data.riskFactors is list && data.riskFactors.size() <= 10);
    }

    function isValidPriority(data) {
      return !('priority' in data) || 
             (data.priority is string && data.priority in ['routine', 'urgent', 'emergency', 'low', 'medium', 'high']);
    }

    function isValidAssessment(data) {
      return isValidOxygen(data) &&
             isValidBreathing(data) &&
             isValidCough(data) &&
             isValidDuration(data) &&
             isValidRiskFactors(data) &&
             isValidPriority(data);
    }

    function isPatientOwnedRecord(data) {
      return ('patientId' in data && data.patientId == request.auth.uid) ||
             ('userId' in data && data.userId == request.auth.uid);
    }

    function isDoctorApprovedCase(data) {
      return ('doctorApproved' in data && data.doctorApproved == true) ||
             ('status' in data && data.status in ['approved', 'closed']);
    }

    function hasNoUnreleasedClinicalResult(data) {
      return !('doctorNotes' in data) &&
             !('clinicalImpression' in data) &&
             !('officialDiagnosis' in data);
    }

    function isPublishedReport(data) {
      return ('status' in data && data.status == 'approved') ||
             ('doctorApproved' in data && data.doctorApproved == true);
    }

    function hasNoPatientForgedClinicalResult(data) {
      return !('doctorNotes' in data) &&
             !('clinicalImpression' in data) &&
             !('officialDiagnosis' in data) &&
             !('doctorApproved' in data || data.doctorApproved == false) &&
             !('approvedAt' in data) &&
             !('assignedDoctorId' in data);
    }

    function isPatientMoreInfoResponse() {
      return isAuthenticated() &&
             resource.data.patientId == request.auth.uid &&
             resource.data.status == 'more_info_requested' &&
             request.resource.data.status == 'under_review' &&
             !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'doctorNotes', 'clinicalImpression', 'officialDiagnosis', 'doctorApproved', 'assignedDoctorId'
             ]);
    }

    function isValidCaseStatus(status) {
      return status in [
        'draft',
        'submitted',
        'triaged',
        'assigned',
        'under_review',
        'more_info_requested',
        'approved',
        'rejected',
        'escalated',
        'closed',
        'pending'
      ];
    }

    // =========================================================================
    // 3. 📋 CLINICAL CASES (/cases/{caseId})
    // =========================================================================
    match /cases/{caseId} {
      allow read: if isOwner() || (isAuthenticated() && 
                     ((resource.data.patientId == request.auth.uid &&
                       (isDoctorApprovedCase(resource.data) || hasNoUnreleasedClinicalResult(resource.data))) ||
                      isAssignedDoctor() ||
                      isAdmin()));

      allow create: if isOwner() || (isEmailVerified() && 
                       request.resource.data.patientId == request.auth.uid &&
                       request.resource.data.status in ['draft', 'submitted', 'triaged', 'assigned', 'pending'] &&
                       hasNoPatientForgedClinicalResult(request.resource.data) &&
                       isValidAssessment(request.resource.data));

      allow update: if isOwner() || (isAuthenticated() &&
                        (isAssignedDoctor() || isAdmin() || isPatientMoreInfoResponse()) &&
                        request.resource.data.patientId == resource.data.patientId &&
                        isValidCaseStatus(request.resource.data.status) &&
                        isValidAssessment(request.resource.data));

      allow delete: if isOwner() || isAdmin();
    }

    match /assessments/{assessmentId} {
      allow read, write: if isOwner();
      allow read: if isAuthenticated() &&
                    ((isPatientOwnedRecord(resource.data) &&
                      (isDoctorApprovedCase(resource.data) || hasNoUnreleasedClinicalResult(resource.data))) ||
                     isAdmin());
    }

    match /reports/{reportId} {
      allow read, write: if isOwner();
      allow read: if isAuthenticated() &&
                    ((isPatientOwnedRecord(resource.data) && isPublishedReport(resource.data)) ||
                     isAdmin());
    }

    match /medical_reports/{reportId} {
      allow read, write: if isOwner();
      allow read: if isAuthenticated() &&
                    ((isPatientOwnedRecord(resource.data) && isPublishedReport(resource.data)) ||
                     isAdmin());
    }

    match /clinical_reports/{reportId} {
      allow read, write: if isOwner();
      allow read: if isAuthenticated() &&
                    ((isPatientOwnedRecord(resource.data) && isPublishedReport(resource.data)) ||
                     isAdmin());
    }

    // =========================================================================
    // 4. 🛡️ SERVER AUDIT EVENTS (/audit_events/{eventId})
    // =========================================================================
    match /audit_events/{eventId} {
      allow read, write: if isOwner();
      allow read: if isAdmin();
    }

    // =========================================================================
    // 5. 📝 CLIENT AUDIT LOG (/auditLog/{logId})
    // =========================================================================
    match /auditLog/{logId} {
      allow read, write: if isOwner();
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (
        ('patientId' in request.resource.data && request.resource.data.patientId == request.auth.uid) ||
        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
      );
    }

    // =========================================================================
    // 6. 📊 AI MODEL METRICS (/ai_model_metrics/{metricId})
    // =========================================================================
    match /ai_model_metrics/{metricId} {
      allow read, write: if isOwner();
      allow read: if isAuthenticated() && (isAdmin() || isDoctor());
      allow write: if isAdmin();
    }

    // =========================================================================
    // 7. 📅 CLINICAL APPOINTMENTS (/appointments/{appointmentId})
    // =========================================================================
    match /appointments/{appointmentId} {
      allow read, write: if isOwner();
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isDoctor() ||
        resource.data.patientId == request.auth.uid
      );

      allow create: if isAuthenticated() &&
                    request.resource.data.patientId == request.auth.uid &&
                    request.resource.data.status in ['confirmed', 'pending'];

      allow update: if isAuthenticated() && (
        isAdmin() ||
        isDoctor() ||
        (resource.data.patientId == request.auth.uid && request.resource.data.patientId == request.auth.uid)
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.patientId == request.auth.uid
      );
    }

    // =========================================================================
    // 8. 📧 EMAIL NOTIFICATIONS (/email_notifications/{notificationId})
    // =========================================================================
    match /email_notifications/{notificationId} {
      allow read, write: if isOwner();
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isDoctor() ||
        resource.data.patientId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.recipient == request.auth.token.email)
      );
      allow write: if false;
    }

    // =========================================================================
    // 9. ⭐ CLINICAL & PATIENT FEEDBACKS (/feedbacks/{feedbackId})
    // =========================================================================
    match /feedbacks/{feedbackId} {
      allow read, write: if isOwner();
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isDoctor() ||
        resource.data.userId == request.auth.uid ||
        resource.data.isPublic == true
      );

      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.rating is number &&
                    request.resource.data.rating >= 1 &&
                    request.resource.data.rating <= 5 &&
                    request.resource.data.role in ['patient', 'doctor', 'clinic_admin', 'super_admin'] &&
                    request.resource.data.comment is string &&
                    request.resource.data.comment.size() > 0 &&
                    request.resource.data.comment.size() <= 2000;

      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 10. 🏥 CLINIC LEADS & DEMO REQUESTS (/clinic_leads/{leadId})
    // =========================================================================
    match /clinic_leads/{leadId} {
      allow read, write: if isOwner() || isAdmin();
      allow create: if true;
    }

    // =========================================================================
    // 11. 👑 MASTER CATCH-ALL OVERRIDE
    // =========================================================================
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
